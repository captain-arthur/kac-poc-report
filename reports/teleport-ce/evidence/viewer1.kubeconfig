apiVersion: v1
clusters:
- cluster:
    certificate-authority-data: 
    extensions:
    - extension: teleport.local
      name: kubeconfig.teleport.dev/teleport-cluster-name
    - extension: teleport.local
      name: teleport.kube.name
    server: https://127.0.0.1:18443
    tls-server-name: kube-teleport-proxy-alpn.teleport.local
  name: teleport.local-teleport.local
contexts:
- context:
    cluster: teleport.local-teleport.local
    extensions:
    - extension: teleport.local
      name: kubeconfig.teleport.dev/teleport-cluster-name
    - extension: teleport.local
      name: teleport.kube.name
    user: teleport.local-teleport.local
  name: teleport.local-teleport.local
current-context: teleport.local-teleport.local
kind: Config
users:
- name: teleport.local-teleport.local
  user:
    client-certificate-data: 
    client-key-data: 
    extensions:
    - extension: teleport.local
      name: kubeconfig.teleport.dev/teleport-cluster-name
    - extension: teleport.local
      name: teleport.kube.name
