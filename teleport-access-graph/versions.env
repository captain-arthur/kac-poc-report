# Pin versions for offline Identity Security / Access Graph POC.
# Teleport cluster used in this repo's CE evidence: 18.10.3
# Access Graph chart/image must match each other (chart version == image tag).

TELEPORT_CLUSTER_CHART_VERSION=18.10.3
ACCESS_GRAPH_VERSION=1.30.2

# Mirrored to Docker Hub (linux/amd64) for air-gap / internal pulls
ACCESS_GRAPH_IMAGE=qlqjs90/access-graph
TELEPORT_IMAGE=qlqjs90/teleport-distroless
POSTGRES_IMAGE=qlqjs90/postgres:16-alpine
UPSTREAM_ACCESS_GRAPH_IMAGE=public.ecr.aws/gravitational/access-graph
UPSTREAM_TELEPORT_IMAGE=public.ecr.aws/gravitational/teleport-distroless
UPSTREAM_POSTGRES_IMAGE=postgres:16-alpine

# Default K8s names (override via env when running scripts)
TELEPORT_NS=teleport
TELEPORT_RELEASE=teleport
TAG_NS=teleport-access-graph
TAG_RELEASE=teleport-access-graph
POSTGRES_NS=teleport-access-graph
